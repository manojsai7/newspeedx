# ============================================
# Megatron File Stream Bot - Environment Variables
# ============================================
# For LOCAL TESTING: Copy this file to .env and fill in your values
# For KOYEB: Upload this file as "Environment Variables (File)" in deployment settings
# For HEROKU: Set these in Config Vars dashboard
# NEVER commit your .env file to git!

# ============================================
# 📋 KOYEB DEPLOYMENT INSTRUCTIONS
# ============================================
# 1. Copy this file and rename to .env
# 2. Fill in all REQUIRED values below
# 3. In Koyeb dashboard → Service Settings → Environment Variables
# 4. Select "File" option
# 5. Upload your .env file
# 6. File Format: Select "Plain Text" or ".env"
# 7. Deploy!

# ============================================
# 🔑 REQUIRED VARIABLES
# ============================================

# Telegram API Credentials (get from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Bot Token (create bot with @BotFather on Telegram)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Channel where files will be stored (MUST start with -100)
# 1. Create a Telegram channel
# 2. Add your bot as admin with "Post Messages" permission
# 3. Get channel ID from @userinfobot or @RawDataBot
BIN_CHANNEL=-1001234567890

# Your Telegram User ID (get from @userinfobot)
OWNER_ID=123456789

# Database URL (MongoDB - REQUIRED for user tracking and security)
# Get free database: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/megatron

# ============================================
# 🎨 CUSTOMIZABLE LINKS & BRANDING
# ============================================

# Updates Channel Link (shown in bot buttons)
# Your channel/group invite link
UPDATES_CHANNEL_LINK=https://t.me/+_J90-7N-lk9iNDZl

# Donation Link (shown in bot buttons)
# Your payment/donation link
DONATION_LINK=https://t.me/YourBot?start=donate

# Support Group/Channel Link
# Your support group/channel link
SUPPORT_LINK=https://t.me/+_J90-7N-lk9iNDZl

# ============================================
# 🔒 FORCE SUBSCRIBE (OPTIONAL)
# ============================================

# Force Subscribe Channel ID
# Users must join this channel to use the bot
# Format: -100 followed by channel ID (leave empty to disable)
# Get ID from: @RawDataBot
# You can also use dynamic /fsub command (recommended)
UPDATES_CHANNEL=

# ============================================
# 🌐 DOMAIN & SERVER CONFIG (AUTO-DETECTED)
# ============================================

# Domain Configuration
# For Koyeb: LEAVE EMPTY - Auto-detected from KOYEB_PUBLIC_DOMAIN
# For custom domain: your-custom-domain.com (without https://)
# For local testing: localhost
FQDN=

# App Name (optional - for logs and identification)
APP_NAME=megatron-bot

# Port for web server (Koyeb uses 8000 by default)
PORT=8000

# Bind address (use 0.0.0.0 for Docker/Koyeb)
WEB_SERVER_BIND_ADDRESS=0.0.0.0

# SSL Settings (auto-detected for Koyeb/Heroku - LEAVE EMPTY)
# HAS_SSL=true
# NO_PORT=true

# ============================================
# ⚙️ OPTIONAL ADVANCED SETTINGS
# ============================================

# Bot Session Name
SESSION_NAME=AvishkarPatil

# Worker Threads (increase for high traffic)
WORKERS=6

# Sleep Threshold (seconds)
SLEEP_THRESHOLD=60

# Ping Interval (seconds) - Keep-alive for Koyeb
# Default: 240 (4 minutes, Koyeb sleeps after 5min inactivity)
PING_INTERVAL=240

# Broadcast as Copy
BROADCAST_AS_COPY=false

# ============================================
# 🔐 LINK SECURITY & EXPIRY
# ============================================

# Link Time-to-Live (seconds)
# Default: 43200 (12 hours)
LINK_TTL_SECONDS=43200

# Short Link Time-to-Live (seconds)
# Default: 604800 (7 days)
SHORT_LINK_TTL_SECONDS=604800

# Secret used to sign secure download tokens (auto-generated if not set)
APP_SECRET=

# ============================================
# 🚦 RATE LIMITING & QUOTAS
# ============================================

# User Rate Limit (requests per window)
USER_RATE_LIMIT=12

# User Rate Window (seconds)
USER_RATE_WINDOW=60

# User Daily Quota (requests per day, 0 = unlimited)
USER_DAILY_QUOTA=0

# Max File Size (MB)
MAX_FILE_SIZE_MB=2048

# ============================================
# 🛡️ SECURITY SETTINGS
# ============================================

# FloodWait handling
MAX_LOGIN_FLOODWAIT=900
LOGIN_FLOODWAIT_PADDING=5

# Banned channels (space-separated channel IDs)
# Bot will auto-leave these channels
# Example: -1001111111 -1002222222
BANNED_CHANNELS=

# ============================================
# 🚀 ADVANCED OPTIONS (LEAVE DEFAULT)
# ============================================

# Multi-client mode (for high traffic - advanced users only)
# MULTI_CLIENT=false

# ============================================
# PLATFORM-SPECIFIC (Auto-injected by platform)
# ============================================

# Koyeb automatically provides these - DO NOT SET:
# KOYEB_PUBLIC_DOMAIN=your-service-your-org.koyeb.app
# KOYEB_DEPLOYMENT_ID=...
# KOYEB_APP_DOMAIN=...

# Heroku automatically provides:
# DYNO=web.1
